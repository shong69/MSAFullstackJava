<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans-3.2.xsd">

	<bean id="handlerMapping"
	class="org.springframework.web.servlet.handler.SimpleUrlHandlerMapping">
		<property name="urlMap">
			<map>
				<entry key="/index.do"><ref bean="index"></ref></entry>
				<entry key="/intro.do"><ref bean="intro"></ref></entry>
				<entry key="/dept/list.do"><ref bean="list"></ref></entry>
				<entry key="/dept/add.do"><ref bean="add"></ref></entry>
			</map>
		</property>
	</bean>
	<bean id="index" class="com.my.controller.IndexController">
		<property name="viewName" value="index"></property>
	</bean>
	<bean id="intro" class="org.springframework.web.servlet.mvc.ParameterizableViewController">
					<!-- viewName을 지정하지 않고 사용할 수 있는 클래스가 존재함 -->
		<property name="viewName" value="intro"></property>
	</bean>
	<bean id="list" class="com.my.controller.ListController">
		<property name="dao" ref="deptDao"></property>
	</bean>
	<bean id="add" class="org.springframework.web.servlet.mvc.ParameterizableViewController">
		<property name="viewName" value="dept/add"></property>
	</bean>
	<!-- view resolver -->
	<bean id="viewResolver" class="org.springframework.web.servlet.view.InternalResourceViewResolver">
		<property name="prefix" value="/WEB-INF/views/"></property>
		<property name="suffix" value=".jsp"></property>
	</bean>
</beans>
