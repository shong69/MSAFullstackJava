<%@ page language="java" contentType="text/html; charset=EUC-KR"
    pageEncoding="EUC-KR"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="EUC-KR">
<title>Insert title here</title>
</head>
<body>
	<h1>구구단 출력</h1>
	<table border="1">
	<thead>
		<tr>
		<%for(int x=2;x<10;x++) {%>
			<td><%=x%>단</td>
		<%} %>
		</tr>
	</thead>
<% for(int i=1;i<10;i++) {%>
		<tr>
		<%for(int j=2;j<10;j++){ %>
			<td><%=j%>X<%=i%>=<%=i*j%></td>
		<%} %>
		</tr>
<%} %>	
	</table>


</body>
</html>