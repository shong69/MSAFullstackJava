<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE sqlMap PUBLIC "-//ibatis.apache.org//DTD SQL Map 2.0//EN" 
	"https://ibatis.apache.org/dtd/sql-map-2.dtd">
<sqlMap>
	<select id="selectAll" resultClass="com.my.sts05.dept.model.DeptVo">
		SELECT * FROM DEPT
	</select>
	<insert id="insertOne" parameterClass="com.my.sts05.dept.model.DeptVo">
		INSERT INTO DEPT VALUES(#deptno#, #dname#,#loc#)
	</insert>
	<select id="selectOne" parameterClass="int" resultClass="com.my.sts05.dept.model.DeptVo">
		SELECT * FROM DEPT WHERE DEPTNO=#value#
	</select>
	<update id="updateOne" parameterClass="com.my.sts05.dept.model.DeptVo">
		UPDATE DEPT SET DNAME=#dname#, LOC=#loc# WHERE DEPTNO = #deptno#
	</update>
	<delete id="deleteOne" parameterClass="int">
		DELETE FROM DEPT WHERE DEPTNO=#deptno#
	</delete>
</sqlMap>
