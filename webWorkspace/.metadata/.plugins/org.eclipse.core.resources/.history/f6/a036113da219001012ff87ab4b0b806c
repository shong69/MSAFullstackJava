<%@ page language="java" contentType="text/html; charset=EUC-KR"
    pageEncoding="EUC-KR"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="EUC-KR">
<title>Insert title here</title>
</head>
<body>
	<h1>구구단 출력</h1>
	<table>
<% for(int i=1;i<10;i++) {%>
		<tr><%=i%>단</tr>
		<tr>
		<%for(int j=2;j<10;j++){ %>
			<td><%=j%>X<%=i%>=<%=i*j%></td>
		<%} %>
		</tr>
<%} %>	
	</table>
	
	<table>
		<%for(int i=2;i<10;i++){ %>
		<thead><tr><th><%=i%>단</th></tr></thead>
		<%} %>
		<tbody>
			<%for(int x=2;x<10;x++){ %>
			<tr>
				<%for(int y=1;y<10;y++) {%>
				<td><%=x%>X<%=y%>=<%=x*y%></td>
				<%} %>
			</tr>
			<%} %>
		</tbody>
	</table>

</body>
</html>